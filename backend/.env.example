# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/interntrack"

# ─── JWT ──────────────────────────────────────────────────────
# IMPORTANT: Use long, random strings (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-char-random-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-at-least-32-char-random-string-for-refresh-tokens
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── File Uploads ─────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ─── Security ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
