// =============================================================================
// File: backend/prisma/schema.prisma
// Purpose: Canonical database schema for InternTrack
// Dependencies: MySQL 8.x, Prisma 5.x
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════

enum Role {
  ADMIN
  MENTOR
  INTERN
}

enum InternStatus {
  PENDING    // Registered, awaiting program/mentor assignment
  ACTIVE     // Actively interning
  COMPLETED  // Finished and approved by admin
  TERMINATED // Removed or dropped
}

enum ProgramDuration {
  ONE_MONTH
  THREE_MONTHS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationType {
  REPORT_APPROVED
  REPORT_REJECTED
  ATTENDANCE_REMINDER
  COMPLETION_ALERT
  CERTIFICATE_READY
  MENTOR_ASSIGNED
  GENERAL
}

// ═══════════════════════════════════════════
// CORE MODELS
// ═══════════════════════════════════════════

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  internProfile    InternProfile?
  mentorProfile    MentorProfile?
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  mentorFeedback   MentorFeedback[] @relation("FeedbackByMentor")
  receivedFeedback MentorFeedback[] @relation("FeedbackForIntern")

  @@map("users")
}

/// Stores refresh tokens for revocation support
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(700)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model InternProfile {
  id          String       @id @default(uuid())
  userId      String       @unique @map("user_id")
  programId   String?      @map("program_id")
  mentorId    String?      @map("mentor_id")
  college     String       @db.VarChar(255)
  domain      String       @db.VarChar(200)
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  requiredHrs Int          @default(40) @map("required_hrs")
  status      InternStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      InternshipProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  attendance   Attendance[]
  dailyReports DailyReport[]
  projects     Project[]
  certificate  Certificate?

  @@index([mentorId])
  @@index([programId])
  @@index([status])
  @@map("intern_profiles")
}

model MentorProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  expertise  String   @db.VarChar(200)
  department String   @db.VarChar(200)
  bio        String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

model InternshipProgram {
  id          String          @id @default(uuid())
  title       String          @db.VarChar(200)
  description String          @db.Text
  duration    ProgramDuration
  reqHours    Int             @default(40) @map("req_hours")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  interns InternProfile[]

  @@map("internship_programs")
}

// ═══════════════════════════════════════════
// ATTENDANCE
// ═══════════════════════════════════════════

model Attendance {
  id               String           @id @default(uuid())
  internId         String           @map("intern_id")
  date             DateTime         @db.Date
  checkIn          DateTime         @map("check_in")
  checkOut         DateTime?        @map("check_out")
  hoursWorked      Decimal?         @map("hours_worked") @db.Decimal(5, 2)
  status           AttendanceStatus @default(PRESENT)
  correctionReason String?          @map("correction_reason") @db.Text
  reopenCount      Int              @default(0) @map("reopen_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  intern InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, date], name: "unique_intern_date")
  @@index([internId])
  @@index([date])
  @@map("attendance")
}

// ═══════════════════════════════════════════
// DAILY REPORTS
// ═══════════════════════════════════════════

model DailyReport {
  id            String       @id @default(uuid())
  internId      String       @map("intern_id")
  date          DateTime     @db.Date
  taskTitle     String       @map("task_title") @db.VarChar(200)
  taskDesc      String       @map("task_desc") @db.Text
  hoursWorked   Decimal      @map("hours_worked") @db.Decimal(5, 2)
  learning      String       @db.Text
  challenges    String       @db.Text
  attachmentUrl String?      @map("attachment_url") @db.VarChar(500)
  status        ReportStatus @default(PENDING)
  mentorComment String?      @map("mentor_comment") @db.Text
  reviewedAt    DateTime?    @map("reviewed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  intern InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([status])
  @@index([date])
  @@map("daily_reports")
}

// ═══════════════════════════════════════════
// PROJECTS & MILESTONES
// ═══════════════════════════════════════════

model Project {
  id          String        @id @default(uuid())
  internId    String        @map("intern_id")
  title       String        @db.VarChar(200)
  description String        @db.Text
  domain      String        @db.VarChar(200)
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  repoUrl     String?       @map("repo_url") @db.VarChar(500)
  status      ProjectStatus @default(NOT_STARTED)
  mentorNotes String?       @map("mentor_notes") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  intern     InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  files      ProjectFile[]

  @@index([internId])
  @@map("projects")
}

model Milestone {
  id                   String          @id @default(uuid())
  projectId            String          @map("project_id")
  title                String          @db.VarChar(200)
  description          String?         @db.Text
  dueDate              DateTime        @map("due_date") @db.Date
  status               MilestoneStatus @default(PENDING)
  completionPercentage Int             @default(0) @map("completion_percentage")
  mentorFeedback       String?         @map("mentor_feedback") @db.Text
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(500)
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_files")
}

// ═══════════════════════════════════════════
// CERTIFICATES
// ═══════════════════════════════════════════

model Certificate {
  id         String   @id @default(uuid())
  internId   String   @unique @map("intern_id")
  certNumber String   @unique @map("cert_number") @db.VarChar(50)
  issuedAt   DateTime @default(now()) @map("issued_at")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  totalHours Int      @map("total_hours")
  filePath   String   @map("file_path") @db.VarChar(500)
  qrCode     String   @map("qr_code") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  intern InternProfile @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// ═══════════════════════════════════════════
// MENTOR FEEDBACK
// ═══════════════════════════════════════════

model MentorFeedback {
  id             String   @id @default(uuid())
  internId       String   @map("intern_id")
  mentorId       String   @map("mentor_id")
  score          Int      @db.TinyInt
  strengths      String   @db.Text
  improvements   String   @db.Text
  recommendation String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  intern User @relation("FeedbackForIntern", fields: [internId], references: [id], onDelete: Cascade)
  mentor User @relation("FeedbackByMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([internId])
  @@index([mentorId])
  @@map("mentor_feedback")
}

// ═══════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String           @db.VarChar(200)
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
